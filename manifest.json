{
  "manifest_version": 3,
  "name": "Autocomplete — Job Application Autofill",
  "version": "1.1.0",
  "description": "One-click autofill + submit for Workday and Ashby account creation and application forms.",

  "permissions": ["storage", "identity"],

  "host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://jobs.ashbyhq.com/*",
    "https://gmail.googleapis.com/*"
  ],

  "oauth2": {
    "client_id": "REPLACE_ME.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Autocomplete",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://*.myworkdayjobs.com/*", "https://jobs.ashbyhq.com/*"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "content/00-namespace.js",
        "content/react-set.js",
        "content/match.js",
        "content/experience.js",
        "content/questions.js",
        "content/radio-groups.js",
        "content/free-text.js",
        "content/filler.js",
        "content/guards.js",
        "sites/workday.js",
        "sites/workday-experience.js",
        "sites/workday-questions.js",
        "sites/ashby.js",
        "sites/index.js",
        "content/registry.js",
        "content/widget.js",
        "content/pill.js",
        "content/main.js"
      ]
    }
  ]
}
