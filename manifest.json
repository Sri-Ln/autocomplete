{
  "manifest_version": 3,
  "name": "Autocomplete — Job Application Autofill",
  "version": "0.1.0",
  "description": "One-click autofill + submit for Workday account creation and application forms.",

  "permissions": ["storage"],

  "host_permissions": ["https://*.myworkdayjobs.com/*"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Autocomplete",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://*.myworkdayjobs.com/*"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "content/00-namespace.js",
        "content/react-set.js",
        "content/match.js",
        "content/questions.js",
        "content/radio-groups.js",
        "content/free-text.js",
        "content/filler.js",
        "content/guards.js",
        "sites/workday.js",
        "sites/index.js",
        "content/registry.js",
        "content/widget.js",
        "content/pill.js",
        "content/main.js"
      ]
    }
  ]
}
